# URL aplikasi web (tanpa garis miring di akhir)
SERVER_URL=http://localhost:3000
# Token dari dashboard admin: "<machineId>.<rahasia>"
AGENT_TOKEN=

# Nama printer persis seperti di Windows (Settings > Printers). Kosong = printer default.
PRINTER_NAME=

# Path LibreOffice. Windows biasanya: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=soffice

# 1 = jangan kirim ke printer, simpan PDF hasil di data/dry-run (untuk uji tanpa printer)
DRY_RUN=0

POLL_MS=2500
HEARTBEAT_MS=20000
# Nozzle check otomatis jika mesin menganggur sekian jam (0 = nonaktif)
NOZZLE_IDLE_HOURS=24
# Antivirus opsional: path clamscan.exe (kosong = lewati)
CLAMSCAN_PATH=
