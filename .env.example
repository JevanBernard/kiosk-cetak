# ===== Web (apps/web/.env.local) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# mock          = simulasi bayar (dev/uji alur)
# doku_checkout = halaman bayar DOKU dengan banyak metode (VA, e-wallet, QRIS, kartu). Hanya butuh DOKU_CLIENT_ID + DOKU_SECRET_KEY. Jalan di sandbox.
# doku          = DOKU SNAP QRIS langsung (butuh DOKU_MERCHANT_ID + DOKU_PRIVATE_KEY; QRIS TIDAK tersedia di sandbox DOKU)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=ganti-dengan-string-acak
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=            # X-PARTNER-ID
DOKU_SECRET_KEY=           # client secret (HMAC_SHA512)
DOKU_MERCHANT_ID=          # hanya untuk PAYMENT_PROVIDER=doku (SNAP QRIS): merchantId dari DOKU setelah QRIS disetujui
# Opsional (doku_checkout): batasi metode, mis. VIRTUAL_ACCOUNT_BCA,EMONEY_OVO,QRIS. Kosong = semua metode yang aktif di akun.
DOKU_PAYMENT_METHODS=
DOKU_TERMINAL_ID=T0001
DOKU_POSTAL_CODE=10110
# Private key RSA (PEM) untuk token B2B; tulis satu baris dengan \n sebagai pemisah baris
DOKU_PRIVATE_KEY=

# Pekerjaan terjadwal: POST /api/cron/tick dengan header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=ganti-dengan-string-acak

# Alert (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
